# Environment Variables for Yojana Saarthi Backend
# Copy this file to .env and fill in your real values.
# NEVER commit your actual .env file to GitHub.

# PostgreSQL Database URL (from neon.tech free tier)
# Format: postgresql://user:password@ep-xxxx.neon.tech/neondb?sslmode=require
# db.js configures TLS itself: it turns TLS off for `sslmode=disable` / localhost
# and enables it everywhere else. The sslmode query parameter is stripped before
# connecting, so you can keep it for compatibility with other tools. To rotate
# the password, rebuild this string in Neon and paste it here and into your
# deploy target's env vars; see README.
DATABASE_URL=postgresql://user:password@your-host.neon.tech/neondb?sslmode=require

# JWT Secret - Generate a strong random string (min 32 characters)
# Example: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your-super-secret-random-string-here

# Port the server runs on locally (Render/Railway set this automatically)
PORT=3000

# Public URL of the app. Used in password-reset and email-verification links,
# and as the default allowed browser origin.
# On Render this must be the full https URL, not localhost.
APP_URL=http://localhost:3000

# Optional: extra browser origins allowed to call the API (comma-separated).
# APP_URL is always allowed; localhost dev origins are added automatically.
CORS_ORIGINS=

# Optional: Admin email addresses (comma-separated)
# Users with these emails will have admin access
ADMIN_EMAILS=admin@example.com

# Optional: Resend API Key for sending emails
# Without this, password reset/verify emails are logged to console
RESEND_API_KEY=re_your_api_key_here

# Optional: Verified sender identity used by Resend
MAIL_FROM=Yojana Saarthi <onboarding@resend.dev>
