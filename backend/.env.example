# Copy this file to .env and fill in your real values.
# Never commit your actual .env file to GitHub.

# Get this from neon.tech (free Postgres database) after creating a project.
# It looks like: postgresql://user:password@ep-xxxx.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql://user:password@host/dbname

# Any long random string - used to sign login tokens. Change this to your own random text.
JWT_SECRET=change-this-to-a-long-random-secret-string

# Port the server runs on locally (Render/Railway set this automatically when deployed)
PORT=3000
